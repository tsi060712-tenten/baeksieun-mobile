#!/usr/bin/env bash
set -euo pipefail

build_dir=".figma/make/deploy-dist"
rm -rf "$build_dir"
mkdir -p "$build_dir"

cp index.html "$build_dir/"
cp -R css js img pdf "$build_dir/"

[[ -f "$build_dir/index.html" ]] || {
  echo "Expected static build output at $build_dir" >&2
  exit 1
}

figma make deploy --build-dir "$build_dir"
