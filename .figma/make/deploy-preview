#!/usr/bin/env bash
set -euo pipefail

build_dir="$(mktemp -d)"
trap 'rm -rf "$build_dir"' EXIT

cp index.html "$build_dir/"
cp -R css js img pdf "$build_dir/"

[[ -f "$build_dir/index.html" ]] || {
  echo "Expected static build output at $build_dir" >&2
  exit 1
}

figma make deploy-preview --build-dir "$build_dir"
